# =========================================================================
# SMART PARKING MONITORING SYSTEM - TIMOR PLAZA DILI
# Environment configuration template.
# Copy this file to `.env` and fill in your own values.
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
# NEVER commit the real `.env` file to Git.
# =========================================================================

# ---------------------------- APACHE KAFKA -------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=parking-events
KAFKA_CLIENT_ID=timor-plaza-producer
KAFKA_GROUP_ID=timor-plaza-consumer
KAFKA_ACKS=all
KAFKA_RETRIES=5
KAFKA_LINGER_MS=10
KAFKA_BATCH_SIZE=16384

# Producer emission rate (events per second): 1, 5, 10, ...
PRODUCER_EVENTS_PER_SECOND=5

# ----------------------------- POSTGRESQL --------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=smart_parking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD

# ----------------------------- APACHE SPARK ------------------------------
SPARK_APP_NAME=TimorPlazaSmartParking
SPARK_MASTER=local[*]
SPARK_LOG_LEVEL=WARN
SPARK_SHUFFLE_PARTITIONS=4
SPARK_MAX_OFFSETS_PER_TRIGGER=1000
SPARK_TRIGGER_INTERVAL=5 seconds
SPARK_STARTING_OFFSETS=latest
SPARK_WATERMARK_DELAY=10 minutes
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1
SPARK_POSTGRES_PACKAGE=org.postgresql:postgresql:42.7.3

# --------------------------- PARKING MODEL -------------------------------
SLOTS_PER_AREA=25
PARKING_OPEN_HOUR=8
PARKING_CLOSE_HOUR=22
MOTORCYCLE_RATIO=0.6

# ------------------------------- ALERTS ----------------------------------
ALERT_WARNING_THRESHOLD=70
ALERT_CRITICAL_THRESHOLD=90

# ----------------------------- DASHBOARD ---------------------------------
DASHBOARD_REFRESH_SECONDS=5

# ------------------------------ LOGGING ----------------------------------
LOG_LEVEL=INFO
